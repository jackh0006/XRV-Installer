<resources>
    <style name="Theme.XRV.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/xrv_primary</item>
        <item name="colorOnPrimary">@color/xrv_on_primary</item>
        <item name="colorPrimaryContainer">@color/xrv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/xrv_on_primary_container</item>
        <item name="colorSecondary">@color/xrv_secondary</item>
        <item name="colorError">@color/xrv_error</item>
        <item name="colorErrorContainer">@color/xrv_error_container</item>
        <item name="colorOnErrorContainer">@color/xrv_on_error_container</item>
        <item name="colorSurface">@color/xrv_surface</item>
        <item name="colorOnSurface">@color/xrv_on_surface</item>
        <item name="colorSurfaceVariant">@color/xrv_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/xrv_on_surface_variant</item>
        <item name="colorOutline">@color/xrv_outline</item>
        <item name="colorOutlineVariant">@color/xrv_outline</item>
        <item name="android:colorBackground">@color/xrv_background</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/xrv_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.XRV.Button</item>
        <item name="materialCardViewStyle">@style/Widget.XRV.Card</item>
        <item name="textInputStyle">@style/Widget.XRV.TextInput</item>
        <item name="android:colorAccent">@color/xrv_primary</item>
    </style>

    <style name="Theme.XRV" parent="Theme.XRV.Base" />

    <style name="Widget.XRV.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.XRV.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.XRV.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.XRV.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/xrv_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/xrv_outline</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>

    <style name="Widget.XRV.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/xrv_primary</item>
        <item name="hintTextColor">@color/xrv_on_surface_variant</item>
        <item name="android:textColorHint">@color/xrv_on_surface_variant</item>
        <item name="errorTextColor">@color/xrv_error</item>
    </style>


    <style name="Text.XRV.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/xrv_on_surface_variant</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.XRV.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/xrv_on_surface_variant</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.XRV.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/xrv_code_text</item>
    </style>
</resources>
