    <string name="about">About</string>
    <string name="about_title">About XRV</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">XRV is a free, open-source client for an encrypted relay that travels over HTTPS. It never contains ads, analytics, remote configuration, or telemetry.</string>
    <string name="about_how_title">How it works</string>
    <string name="about_how_body">TUN mode creates a local VPN interface and forwards each connection through the encrypted relay. Proxy-only mode exposes the same encrypted relay as a loopback SOCKS5 proxy so apps such as v2rayNG can use it directly.</string>
    <string name="about_security_title">Security</string>
    <string name="about_security_body">Tunnel frames use AES-256-GCM. The tunnel key is encrypted at rest with a non-exportable Android Keystore key. The app logs no payloads or secrets; its local event and native logs are bounded and redacted. It allows no cleartext traffic and does not trust user-installed certificate authorities.</string>
    <string name="about_proxy_title">Using a proxy</string>
    <string name="about_proxy_body">In Proxy-only mode the address is socks5://127.0.0.1:PORT. DNS is resolved by the exit, so use the SOCKS5 hostname form. Do not route another VPN app through this local proxy while that VPN is also active, or traffic can loop; use TUN mode for system-wide protection.</string>
    <string name="about_support_title">Support the project</string>
    <string name="about_support_body">Donations are optional and irreversible. Verify every address in the project source before sending. XRV never asks for a seed phrase or private key.</string>
    <string name="about_wallets_hint">Tap an address to copy it.</string>
    <string name="about_guide">Complete user guide</string>
    <string name="about_guide_url">https://github.com/jackh0006/XRV-Installer/blob/main/GUIDE.md</string>
    <string name="about_source">Source code</string>
    <string name="about_source_url">https://github.com/jackh0006/XRV-Installer</string>
    <string name="about_made_by">Made by jackh0006 · jackh109867@gmail.com</string>

