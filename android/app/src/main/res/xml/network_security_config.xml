<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext, and no user-installed CAs: an attacker who can install a
         root CA on the device still cannot silently read relay traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
